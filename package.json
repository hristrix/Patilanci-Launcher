{
  "name": "patilanci-launcher",
  "version": "2.3.0",
  "description": "Patilanci SMP desktop launcher",
  "dependencies": {
    "@fontsource/manrope": "5.3.0",
    "@fontsource/oswald": "5.3.0",
    "adm-zip": "^0.6.1",
    "electron-updater": "^6.8.9",
    "lucide-react": "^0.468.0",
    "minecraft-launcher-core": "^3.18.2",
    "minecraft-server-util": "^5.4.4",
    "msmc": "^5.0.5",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "skinview3d": "3.4.2"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.0",
    "@vitejs/plugin-react": "^5.0.0",
    "electron": "^41.0.0",
    "electron-builder": "^26.0.0",
    "prettier": "3.9.10",
    "tailwindcss": "^4.1.0",
    "vite": "^7.0.0"
  },
  "overrides": {
    "adm-zip": "$adm-zip",
    "request": {
      "form-data": "^2.5.6",
      "qs": "^6.16.0",
      "tough-cookie": "^4.1.4"
    }
  },
  "main": "electron/main.cjs",
  "packageManager": "npm@10.9.4",
  "scripts": {
    "start": "npm run build && node electron/run.cjs .",
    "start:compat": "npm run build && node electron/run.cjs . --disable-gpu",
    "dev": "vite --host 127.0.0.1",
    "build": "vite build",
    "dist": "node packaging/build.cjs installer",
    "dist:preview": "node packaging/build.cjs preview",
    "dist:store": "node packaging/build.cjs store",
    "dist:store:preview": "node packaging/build.cjs store-preview",
    "build:artwork": "node electron/run.cjs packaging/generate-artwork.cjs --disable-gpu",
    "start:download-service": "node server/download-service.cjs",
    "test": "node --test tests/*.test.cjs",
    "check:lockfile": "node packaging/check-lockfile.cjs",
    "check:release": "node packaging/check-release.cjs",
    "check:installer": "node packaging/verify-installer.cjs",
    "validate": "npm run check:release && npm test && npm run build && npm run test:desktop -- --disable-gpu && npm run test:console && npm run test:setup",
    "test:setup": "node packaging/setup/smoke.cjs",
    "test:desktop": "node electron/run.cjs electron/smoke.cjs",
    "test:console": "node electron/run.cjs electron/console-smoke.cjs",
    "test:exit": "node electron/run.cjs electron/exit-smoke.cjs",
    "version:patch": "npm version patch --no-git-tag-version",
    "version:hotfix": "npm run version:patch",
    "version:minor": "npm version minor --no-git-tag-version",
    "version:major": "npm version major --no-git-tag-version",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "keywords": [],
  "author": "Hristrix",
  "homepage": "https://hristrix.com",
  "license": "ISC",
  "type": "commonjs"
}
